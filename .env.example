# Provider keys — read only by lib/providers/env.ts, on the harness side.
# Never prefix these NEXT_PUBLIC_: Next would inline them into the replay page.

# Free tier: https://console.groq.com/keys
GROQ_API_KEY=

# Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Free tier: https://openrouter.ai/keys — reaches most free open-weight models on
# /race. Its model list shows without a key; racing one needs it. 50 requests/day free.
# Claude models on /race also go through this key. Claude has no free tier: add
# credit to the key to race them; the results show what each race cost.
OPENROUTER_API_KEY=

# /race and /api/race run models on the keys above. On under `next dev`; a
# production build 404s them unless this is 1. Never set it on the public site.
ENABLE_LOCAL_RACE=

# Watch-through telemetry (TICKET-11) — docs/decisions/telemetry.md.
# Read at `next build` by lib/telemetry/config.ts; unset = telemetry off. Set it
# only in the environment that builds the PUBLIC site, not here, or your own dev
# views are counted. A public Umami Cloud website id (a UUID), not a key.
UMAMI_WEBSITE_ID=

# Read only by scripts/watch-through.mts. Never prefix NEXT_PUBLIC_.
UMAMI_API_KEY=
